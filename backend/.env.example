# DigBahi Backend — Environment Configuration
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env to git — it is already in .gitignore.

# ─── Required ────────────────────────────────────────────────────────────────

# Comma-separated list of origins the browser is served from.
# Example: http://localhost:5173,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── WhatsApp Business API (Meta Cloud API) ───────────────────────────────────
# Get these from Meta Business Manager → WhatsApp → API Setup.
# Rotate WHATSAPP_ACCESS_TOKEN every 60 days, or use a System User permanent token.

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# WhatsApp API version (check Meta docs for latest stable)
WHATSAPP_API_VERSION=v19.0

# WhatsApp approved message template names (create in Meta Business Manager)
WHATSAPP_OTP_TEMPLATE_NAME=digbahi_otp
WHATSAPP_INVOICE_TEMPLATE_NAME=digbahi_invoice
WHATSAPP_REPORT_TEMPLATE_NAME=digbahi_report

# ─── Google Cloud Vision (optional — enables cloud OCR mode) ─────────────────
# Paste the full JSON contents of your service account key file.
# Leave empty to use local Tesseract OCR only.
GOOGLE_CREDENTIALS_JSON=

# ─── Database (SQLite — default, no config needed for local deploy) ───────────
# DB_PATH=./digbahi_local.db

# ─── Federated Learning (optional) ───────────────────────────────────────────
# FEDERATED_AES_KEY=your_base64_encoded_key
# FEDERATED_MASTER_SECRET=your_master_secret
# FEDERATED_SALT=your_salt_hex_string

# ─── Token rotation reminder ─────────────────────────────────────────────────
# WHATSAPP_ACCESS_TOKEN expires every 60 days (default Meta setting).
# For a permanent token: Meta Business Manager → System Users → Add Asset
# → Generate Token → select whatsapp_business_messaging permission.

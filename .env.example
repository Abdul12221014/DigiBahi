# DigBahi Environment Variables
# Copy this file to .env and fill in your values

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_OCR_SERVICE_URL=http://localhost:9000

# WhatsApp Business API (Cloud API via Meta)
# Get these from: https://developers.facebook.com/ → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here
WHATSAPP_API_VERSION=v22.0

# WhatsApp Message Template Names (must be approved in Meta Business Manager)
WHATSAPP_OTP_TEMPLATE_NAME=digbahi_otp
WHATSAPP_INVOICE_TEMPLATE_NAME=digbahi_invoice
WHATSAPP_REPORT_TEMPLATE_NAME=digbahi_report

# Federated AI (optional — leave unset to disable)
FEDERATED_MASTER_SECRET=change_this_to_a_random_32_char_string
